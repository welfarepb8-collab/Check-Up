  <script>
    // เก็บวันที่ของ "การจองเดิม" ของพนักงานที่กำลังค้นหา/แก้ไขอยู่ (ถ้ามี)
    // ใช้เพื่อไม่ล็อกปุ่มเลือกวันเดิมของตัวเอง แม้รอบนั้นจะเต็มแล้วก็ตาม
    let loadedBookingDate = null;

    // ===================== Wizard (ระบบขั้นตอนหลายหน้า) =====================
    let currentStep = 1;               // ขั้นตอนปัจจุบันที่กำลังแสดง (1-4)
    let isEditingExisting = false;     // true เมื่อกำลังแก้ไขรายการที่มีอยู่แล้ว (ไม่ใช่จองใหม่)

    // ตรวจสอบความถูกต้องของข้อมูลในแต่ละขั้นตอน ก่อนอนุญาตให้ไปขั้นตอนถัดไป
    function validateStep(step) {
      if (step === 1) {
        const ids = ['empId', 'name', 'position', 'department', 'division', 'section'];
        for (const id of ids) {
          const el = document.getElementById(id);
          if (!el.value.trim()) {
            Swal.fire({
              icon: 'warning',
              title: 'ข้อมูลไม่ครบถ้วน',
              text: 'กรุณากรอกข้อมูลผู้ลงทะเบียนให้ครบทุกช่องก่อนไปขั้นตอนถัดไป',
              confirmButtonColor: '#DA251D'
            });
            el.focus();
            return false;
          }
        }
        return true;
      }
      if (step === 2) {
        if (!document.querySelector('input[name="location"]:checked')) {
          Swal.fire({
            icon: 'warning',
            title: 'กรุณาเลือกจุดขึ้นรถ',
            text: 'โปรดเลือกสถานที่ขึ้นรถก่อนไปขั้นตอนถัดไป',
            confirmButtonColor: '#DA251D'
          });
          return false;
        }
        return true;
      }
      if (step === 3) {
        if (!document.querySelector('input[name="date"]:checked')) {
          Swal.fire({
            icon: 'warning',
            title: 'กรุณาเลือกวันที่เดินทาง',
            text: 'โปรดเลือกวันที่เดินทางไปตรวจสุขภาพก่อนไปขั้นตอนถัดไป',
            confirmButtonColor: '#DA251D'
          });
          return false;
        }
        return true;
      }
      return true;
    }

    // ไปขั้นตอนถัดไป (ตรวจสอบข้อมูลขั้นตอนปัจจุบันก่อนเสมอ)
    function nextStep() {
      if (!validateStep(currentStep)) return;
      if (currentStep < 4) goToStep(currentStep + 1, { skipValidation: true });
    }

    // ย้อนกลับไปขั้นตอนก่อนหน้า (ไม่ต้องตรวจสอบข้อมูล)
    function prevStep() {
      if (currentStep > 1) goToStep(currentStep - 1, { skipValidation: true });
    }

    // ไปยังขั้นตอนที่ระบุโดยตรง เช่น กดปุ่ม "แก้ไข" จากหน้าตรวจสอบ หรือหลังค้นหาพบข้อมูล
    // opts.skipValidation = true จะข้ามการตรวจสอบข้อมูลของขั้นตอนที่ผ่านมา (ใช้เมื่อข้อมูลถูกโหลดมาจากระบบแล้ว)
    function goToStep(step, opts) {
      opts = opts || {};
      if (!opts.skipValidation) {
        for (let s = currentStep; s < step; s++) {
          if (!validateStep(s)) return;
        }
      }
      currentStep = step;

      document.querySelectorAll('.step-panel').forEach(function(panel) {
        panel.classList.add('hidden');
      });
      const target = document.getElementById('step' + step);
      if (target) target.classList.remove('hidden');

      if (step === 4) populateReview();

      updateStepIndicator();
      updateNavButtons();

      const scrollTarget = document.getElementById('wizardTop');
      if (scrollTarget) scrollTarget.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // อัปเดตสีและสถานะของแถบขั้นตอนด้านบน (วงกลม + เส้นเชื่อม)
    function updateStepIndicator() {
      document.querySelectorAll('[data-step-indicator]').forEach(function(el) {
        const num = parseInt(el.getAttribute('data-step-indicator'), 10);
        const circle = el.querySelector('.step-circle');
        const label = el.querySelector('.step-label');
        if (num < currentStep) {
          circle.className = 'step-circle w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold bg-emerald-500 text-white transition-colors';
          circle.innerHTML = '<i class="fa-solid fa-check text-xs"></i>';
          label.className = 'step-label text-[10px] sm:text-xs font-semibold text-emerald-600 mt-1.5 text-center';
        } else if (num === currentStep) {
          circle.className = 'step-circle w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold bg-pb-red text-white transition-colors';
          circle.innerHTML = String(num);
          label.className = 'step-label text-[10px] sm:text-xs font-bold text-pb-red mt-1.5 text-center';
        } else {
          circle.className = 'step-circle w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold bg-slate-200 text-slate-500 transition-colors';
          circle.innerHTML = String(num);
          label.className = 'step-label text-[10px] sm:text-xs font-medium text-slate-400 mt-1.5 text-center';
        }
      });
      document.querySelectorAll('.step-connector').forEach(function(line, idx) {
        line.className = (idx + 1 < currentStep)
          ? 'step-connector flex-1 h-1 mx-1 sm:mx-2 rounded bg-emerald-500 transition-colors'
          : 'step-connector flex-1 h-1 mx-1 sm:mx-2 rounded bg-slate-200 transition-colors';
      });
    }

    // แสดง/ซ่อนปุ่มด้านล่างให้ตรงกับขั้นตอนปัจจุบัน
    function updateNavButtons() {
      document.getElementById('btnBack').classList.toggle('hidden', currentStep === 1);
      document.getElementById('btnNext').classList.toggle('hidden', currentStep === 4);
      document.getElementById('btnSubmit').classList.toggle('hidden', currentStep !== 4);
      document.getElementById('btnCancel').classList.toggle('hidden', !(currentStep === 4 && isEditingExisting));
    }

    // สรุปข้อมูลที่กรอกไว้ทั้งหมด แสดงในหน้าตรวจสอบ/ยืนยัน (ขั้นตอนที่ 4)
    function populateReview() {
      const empId = document.getElementById('empId').value.trim();
      const name = document.getElementById('name').value.trim();
      const position = document.getElementById('position').value.trim();
      const department = document.getElementById('department').value.trim();
      const division = document.getElementById('division').value.trim();
      const section = document.getElementById('section').value.trim();
      const locationRadio = document.querySelector('input[name="location"]:checked');
      const dateRadio = document.querySelector('input[name="date"]:checked');

      document.getElementById('reviewEmpInfo').innerText =
        empId + ' — ' + name + ' (' + position + ' / ' + department + ' / ' + division + ' / ' + section + ')';
      document.getElementById('reviewLocation').innerText = locationRadio ? locationRadio.value : '-';
      document.getElementById('reviewDate').innerText = dateRadio ? dateRadio.value : '-';
    }
    // =================== จบส่วน Wizard ===================

    // ===================== Admin Mode =====================
    // รหัสผ่านผู้ดูแลระบบที่ยืนยันแล้ว (เก็บไว้ในหน่วยความจำของเบราว์เซอร์เท่านั้น ไม่บันทึกถาวร)
    let adminPassword = null;
    let allAdminBookings = [];

    // เปิดหน้าต่างสำหรับกรอกรหัสผ่านผู้ดูแลระบบ
    function openAdminLogin() {
      Swal.fire({
        title: 'เข้าสู่ระบบผู้ดูแลระบบ',
        input: 'password',
        inputLabel: 'กรุณากรอกรหัสผ่านผู้ดูแลระบบ',
        inputPlaceholder: 'รหัสผ่าน',
        showCancelButton: true,
        confirmButtonText: 'เข้าสู่ระบบ',
        cancelButtonText: 'ยกเลิก',
        confirmButtonColor: '#DA251D',
        inputAttributes: { autocapitalize: 'off', autocorrect: 'off' }
      }).then((result) => {
        if (!result.isConfirmed || !result.value) return;

        Swal.fire({
          title: 'กำลังตรวจสอบ...',
          allowOutsideClick: false,
          didOpen: () => { Swal.showLoading(); }
        });

        google.script.run
          .withSuccessHandler(function(res) {
            if (res && res.success) {
              adminPassword = result.value;
              document.getElementById('adminStatusBar').classList.remove('hidden');
              document.getElementById('btnAdminLogin').classList.add('hidden');
              document.getElementById('adminPanel').classList.remove('hidden');
              Swal.fire({
                icon: 'success',
                title: 'เข้าสู่ระบบสำเร็จ',
                text: 'ขณะนี้คุณอยู่ในโหมดผู้ดูแลระบบ สามารถแก้ไข/ยกเลิกข้อมูลแทนพนักงานได้แม้เกินกำหนดเวลาล่วงหน้า',
                confirmButtonColor: '#DA251D'
              });
              loadAdminBookings();
            } else {
              Swal.fire('รหัสผ่านไม่ถูกต้อง', 'กรุณาตรวจสอบรหัสผ่านผู้ดูแลระบบอีกครั้ง', 'error');
            }
          })
          .withFailureHandler(function(err) {
            Swal.fire('ข้อผิดพลาด', err.message || 'ไม่สามารถติดต่อเซิร์ฟเวอร์ได้', 'error');
          })
          .adminLogin(result.value);
      });
    }

    // ออกจากโหมดผู้ดูแลระบบ
    function adminLogout() {
      adminPassword = null;
      allAdminBookings = [];
      document.getElementById('adminStatusBar').classList.add('hidden');
      document.getElementById('btnAdminLogin').classList.remove('hidden');
      document.getElementById('adminPanel').classList.add('hidden');
      resetForm();
    }

    // โหลดรายการจองทั้งหมดจากเซิร์ฟเวอร์ (เฉพาะโหมดผู้ดูแลระบบ)
    function loadAdminBookings() {
      if (!adminPassword) return;
      document.getElementById('adminTableBody').innerHTML = '<tr><td colspan="6" class="px-3 py-6 text-center text-slate-400">กำลังโหลดข้อมูล...</td></tr>';

      google.script.run
        .withSuccessHandler(function(list) {
          allAdminBookings = list || [];
          renderAdminTable();
        })
        .withFailureHandler(function(err) {
          document.getElementById('adminTableBody').innerHTML = '<tr><td colspan="6" class="px-3 py-6 text-center text-red-500">โหลดข้อมูลไม่สำเร็จ: ' + (err.message || '') + '</td></tr>';
        })
        .adminGetAllBookings(adminPassword);
    }

    // วาดตารางรายการจองทั้งหมด พร้อมรองรับการค้นหา/กรอง
    function renderAdminTable() {
      const filterText = (document.getElementById('adminFilterInput').value || '').trim().toLowerCase();
      const tbody = document.getElementById('adminTableBody');

      const filtered = allAdminBookings.filter(function(b) {
        if (!filterText) return true;
        return (String(b.empId).toLowerCase().includes(filterText) || String(b.name).toLowerCase().includes(filterText));
      });

      if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="px-3 py-6 text-center text-slate-400">ไม่พบข้อมูล</td></tr>';
        return;
      }

      tbody.innerHTML = filtered.map(function(b) {
        const statusBadge = b.status === 'Cancelled'
          ? '<span class="inline-flex px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-500">ยกเลิกแล้ว</span>'
          : '<span class="inline-flex px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-700">จองแล้ว</span>';
        const cancelBtn = b.status === 'Cancelled'
          ? ''
          : '<button type="button" onclick="adminCancelRow(\'' + String(b.empId).replace(/'/g, "\\'") + '\')" class="text-red-600 hover:text-red-800 font-medium ml-2"><i class="fa-solid fa-ban"></i> ยกเลิก</button>';
        return '<tr class="hover:bg-slate-50">' +
          '<td class="px-3 py-2 font-semibold text-slate-700">' + escapeHtml(b.empId) + '</td>' +
          '<td class="px-3 py-2">' + escapeHtml(b.name) + '</td>' +
          '<td class="px-3 py-2 text-slate-500">' + escapeHtml(b.department) + ' / ' + escapeHtml(b.section) + '</td>' +
          '<td class="px-3 py-2">' + escapeHtml(b.date) + '</td>' +
          '<td class="px-3 py-2">' + statusBadge + '</td>' +
          '<td class="px-3 py-2 text-center whitespace-nowrap">' +
            '<button type="button" onclick="adminEditRow(\'' + String(b.empId).replace(/'/g, "\\'") + '\')" class="text-pb-red hover:text-pb-darkred font-medium"><i class="fa-solid fa-pen-to-square"></i> แก้ไข</button>' +
            cancelBtn +
          '</td>' +
        '</tr>';
      }).join('');
    }

    // ป้องกัน HTML injection เวลาแสดงข้อมูลในตาราง
    function escapeHtml(str) {
      const div = document.createElement('div');
      div.innerText = (str === null || str === undefined) ? '' : String(str);
      return div.innerHTML;
    }

    // โหลดข้อมูลของพนักงานคนที่เลือกจากตาราง Admin เข้าสู่ฟอร์มเพื่อแก้ไข
    function adminEditRow(empId) {
      if (!adminPassword) return;
      document.getElementById('searchEmpId').value = empId;
      window.scrollTo({ top: 0, behavior: 'smooth' });

      Swal.fire({
        title: 'กำลังโหลดข้อมูล...',
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); }
      });

      google.script.run
        .withSuccessHandler(function(data) {
          Swal.close();
          if (!data) return;
          document.getElementById('empId').value = data.empId || '';
          document.getElementById('name').value = data.name || '';
          document.getElementById('position').value = data.position || '';
          document.getElementById('department').value = data.department || '';
          document.getElementById('division').value = data.division || '';
          document.getElementById('section').value = data.section || '';

          loadedBookingDate = data.date || null;

          const locInput = document.querySelector(`input[name="location"][value="${data.location}"]`);
          if (locInput) locInput.checked = true;

          const dateInput = document.querySelector(`input[name="date"][value="${data.date}"]`);
          if (dateInput) dateInput.checked = true;

          document.getElementById('btnSubmit').innerHTML = '<i class="fa-solid fa-user-shield"></i> บันทึกการแก้ไข (Admin)';
          isEditingExisting = true;

          updateTicketPreview();
          refreshAvailability();
          goToStep(4, { skipValidation: true });
        })
        .withFailureHandler(function(err) {
          Swal.fire('ข้อผิดพลาด', err.message || 'ไม่สามารถโหลดข้อมูลได้', 'error');
        })
        .adminSearchBooking(empId, adminPassword);
    }

    // ยกเลิกการจองของพนักงานคนที่เลือกโดยตรงจากตาราง Admin
    function adminCancelRow(empId) {
      if (!adminPassword) return;

      Swal.fire({
        title: 'ยืนยันการยกเลิก?',
        text: 'ต้องการยกเลิกการจองคิวของรหัสพนักงาน ' + empId + ' ใช่หรือไม่ (Admin สามารถยกเลิกได้แม้เกินกำหนดเวลา)',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#DA251D',
        cancelButtonColor: '#64748B',
        confirmButtonText: 'ยืนยันยกเลิกจอง',
        cancelButtonText: 'ย้อนกลับ'
      }).then((result) => {
        if (!result.isConfirmed) return;

        Swal.fire({
          title: 'กำลังยกเลิก...',
          allowOutsideClick: false,
          didOpen: () => { Swal.showLoading(); }
        });

        google.script.run
          .withSuccessHandler(function(res) {
            if (res.success) {
              Swal.fire({ icon: 'success', title: 'ยกเลิกสำเร็จ!', text: res.message, confirmButtonColor: '#DA251D' });
              loadAdminBookings();
              refreshAvailability();
            } else {
              Swal.fire('ข้อผิดพลาด', res.message, 'error');
            }
          })
          .withFailureHandler(function(err) {
            Swal.fire('ข้อผิดพลาด', err.message || 'ไม่สามารถติดต่อเซิร์ฟเวอร์ได้', 'error');
          })
          .adminCancelBooking(empId, adminPassword);
      });
    }
    // =================== จบส่วน Admin Mode ===================

    // ดึงจำนวนที่นั่งคงเหลือของทุกรอบจากฝั่งเซิร์ฟเวอร์ แล้วนำมาอัปเดตหน้าจอ
    function refreshAvailability() {
      google.script.run
        .withSuccessHandler(renderAvailability)
        .withFailureHandler(function(err) {
          console.error('ไม่สามารถโหลดข้อมูลที่นั่งคงเหลือ:', err);
        })
        .getAvailability();
    }

    // แสดงจำนวนที่นั่งคงเหลือบนการ์ดแต่ละวัน และปิดการเลือกวันที่เต็มแล้ว
    function renderAvailability(availability) {
      if (!availability) return;

      document.querySelectorAll('[data-date-tile]').forEach(function(label) {
        const dateValue = label.getAttribute('data-date-tile');
        const info = availability[dateValue];
        const seatInfoEl = label.querySelector('.seat-info');
        const radioInput = label.querySelector('input[name="date"]');
        const tileDiv = label.querySelector('.radio-tile');
        if (!info || !seatInfoEl || !radioInput || !tileDiv) return;

        const isOwnCurrentDate = (loadedBookingDate === dateValue);

        if (info.full && !isOwnCurrentDate) {
          seatInfoEl.textContent = 'ที่นั่งเต็มแล้ว';
          seatInfoEl.className = 'seat-info text-[10px] font-semibold mt-1 text-red-500';
          radioInput.disabled = true;
          tileDiv.classList.add('opacity-50', 'cursor-not-allowed');
          label.classList.add('cursor-not-allowed');
        } else {
          radioInput.disabled = false;
          tileDiv.classList.remove('opacity-50', 'cursor-not-allowed');
          label.classList.remove('cursor-not-allowed');

          if (isOwnCurrentDate) {
            seatInfoEl.textContent = 'รอบที่คุณจองไว้';
            seatInfoEl.className = 'seat-info text-[10px] font-semibold mt-1 text-pb-red';
          } else if (info.remaining <= 3) {
            seatInfoEl.textContent = 'เหลือ ' + info.remaining + ' ที่นั่ง';
            seatInfoEl.className = 'seat-info text-[10px] font-semibold mt-1 text-amber-600';
          } else {
            seatInfoEl.textContent = 'เหลือ ' + info.remaining + ' ที่นั่ง';
            seatInfoEl.className = 'seat-info text-[10px] font-semibold mt-1 text-emerald-600';
          }
        }
      });
    }

    // Live preview update logic
    function updateTicketPreview() {
      const empId = document.getElementById('empId').value.trim();
      const name = document.getElementById('name').value.trim();
      const position = document.getElementById('position').value.trim();
      const department = document.getElementById('department').value.trim();
      
      const locationRadio = document.querySelector('input[name="location"]:checked');
      const dateRadio = document.querySelector('input[name="date"]:checked');

      document.getElementById('previewEmpId').innerText = empId || '---';
      document.getElementById('previewName').innerText = name || '--- ยังไม่ได้ระบุ ---';
      document.getElementById('previewPos').innerText = (position || department) ? `${position} / ${department}` : '---';
      
      document.getElementById('previewLocation').innerText = locationRadio ? locationRadio.value : 'ยังไม่ได้เลือกจุดขึ้นรถ';
      document.getElementById('previewDate').innerText = dateRadio ? dateRadio.value : 'ยังไม่ได้เลือกวันที่';

      const statusBadge = document.getElementById('previewStatus');
      if (document.getElementById('btnSubmit').innerText.includes('อัปเดต')) {
        statusBadge.className = "inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-700";
        statusBadge.innerText = "กำลังแก้ไขข้อมูล";
      } else if (empId && name && locationRadio && dateRadio) {
        statusBadge.className = "inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-700";
        statusBadge.innerText = "พร้อมบันทึก";
      } else {
        statusBadge.className = "inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-500";
        statusBadge.innerText = "รอลงทะเบียน";
      }
    }

    function submitForm() {
      const form = document.getElementById('bookingForm');
      const isAdmin = !!adminPassword;
      
      Swal.fire({
        title: 'กำลังบันทึกข้อมูล...',
        text: 'โปรดรอสักครู่ ระบบกำลังส่งข้อมูลเข้าฐานข้อมูล',
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); }
      });

      const runner = google.script.run
        .withSuccessHandler(function(response) {
          if(response.success) {
            Swal.fire({
              icon: 'success',
              title: 'บันทึกสำเร็จ!',
              text: response.message,
              confirmButtonColor: '#DA251D',
              confirmButtonText: 'ตกลง'
            });
            resetForm();
            refreshAvailability();
            if (isAdmin) loadAdminBookings();
          } else {
            Swal.fire({
              icon: 'error',
              title: 'ไม่สามารถดำเนินการได้',
              text: response.message,
              confirmButtonColor: '#DA251D'
            });
            refreshAvailability();
          }
        })
        .withFailureHandler(function(error) { 
          Swal.fire('ข้อผิดพลาดระบบ', error.message || 'ไม่สามารถติดต่อเซิร์ฟเวอร์ได้', 'error'); 
        });

      if (isAdmin) {
        runner.adminSaveBooking(form, adminPassword);
      } else {
        runner.saveBooking(form);
      }
    }

    function searchBooking() {
      const empId = document.getElementById('searchEmpId').value.trim();
      if (!empId) {
        Swal.fire({
          icon: 'warning',
          title: 'แจ้งเตือน',
          text: 'กรุณากรอกรหัสพนักงานก่อนทำการค้นหา',
          confirmButtonColor: '#DA251D'
        });
        return;
      }

      Swal.fire({
        title: 'กำลังค้นหา...',
        text: `ตรวจสอบข้อมูลการจองรหัส ${empId}`,
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); }
      });

      google.script.run
        .withSuccessHandler(function(data) {
          if (data) {
            document.getElementById('empId').value = data.empId || '';
            document.getElementById('name').value = data.name || '';
            document.getElementById('position').value = data.position || '';
            document.getElementById('department').value = data.department || '';
            document.getElementById('division').value = data.division || '';
            document.getElementById('section').value = data.section || '';

            // จดจำวันที่จองเดิมของพนักงานคนนี้ เพื่อไม่ให้ระบบล็อกรอบเดิมของตัวเอง
            loadedBookingDate = data.date || null;
            
            const locInput = document.querySelector(`input[name="location"][value="${data.location}"]`);
            if (locInput) locInput.checked = true;

            const dateInput = document.querySelector(`input[name="date"][value="${data.date}"]`);
            if (dateInput) dateInput.checked = true;
            
            document.getElementById('btnSubmit').innerHTML = '<i class="fa-solid fa-pen-to-square"></i> อัปเดตข้อมูลการจอง';
            isEditingExisting = true;
            
            updateTicketPreview();
            refreshAvailability();

            Swal.fire({
              icon: 'success',
              title: 'พบข้อมูลการจอง',
              text: 'ระบบพาคุณไปยังหน้าตรวจสอบข้อมูล คุณสามารถกด "แก้ไข" ในแต่ละส่วนเพื่อเปลี่ยนสถานที่หรือวันที่เดินทางได้',
              confirmButtonColor: '#DA251D'
            }).then(function() {
              goToStep(4, { skipValidation: true });
            });
          } else {
            Swal.fire({
              icon: 'info',
              title: 'ไม่พบประวัติการจอง',
              text: 'รหัสพนักงานนี้ยังไม่มีคิวในระบบ กรุณากรอกข้อมูลเพื่อจองคิวใหม่',
              confirmButtonColor: '#DA251D'
            });
            document.getElementById('bookingForm').reset();
            document.getElementById('empId').value = empId;
            document.getElementById('btnSubmit').innerHTML = '<i class="fa-solid fa-paper-plane"></i> ยืนยันและบันทึกข้อมูล';
            isEditingExisting = false;
            loadedBookingDate = null;
            goToStep(1, { skipValidation: true });
            updateTicketPreview();
            refreshAvailability();
          }
        })
        .withFailureHandler(function(err) {
          Swal.fire('ข้อผิดพลาด', err.message, 'error');
        })
        .getBooking(empId);
    }

    function cancelBookingAction() {
      const empId = document.getElementById('empId').value;
      if(!empId) return;
      const isAdmin = !!adminPassword;
      
      Swal.fire({
        title: 'ยืนยันการยกเลิก?',
        text: "คุณต้องการยกเลิกคิวรถตรวจสุขภาพนี้ใช่หรือไม่ (สามารถจองใหม่ได้หากยังไม่หมดเขต)",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#DA251D',
        cancelButtonColor: '#64748B',
        confirmButtonText: 'ยืนยันยกเลิกจอง',
        cancelButtonText: 'ย้อนกลับ'
      }).then((result) => {
        if (result.isConfirmed) {
          Swal.fire({
            title: 'กำลังยกเลิก...',
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); }
          });
          
          const runner = google.script.run
            .withSuccessHandler(function(res) {
              if(res.success) {
                Swal.fire({
                  icon: 'success',
                  title: 'ยกเลิกสำเร็จ!',
                  text: res.message,
                  confirmButtonColor: '#DA251D'
                });
                resetForm();
                refreshAvailability();
                if (isAdmin) loadAdminBookings();
              } else {
                Swal.fire('ข้อผิดพลาด', res.message, 'error');
                refreshAvailability();
              }
            })
            .withFailureHandler(function(err) {
              Swal.fire('ข้อผิดพลาด', err.message, 'error');
            });

          if (isAdmin) {
            runner.adminCancelBooking(empId, adminPassword);
          } else {
            runner.cancelBooking(empId);
          }
        }
      });
    }

    function resetForm() {
      document.getElementById('bookingForm').reset();
      document.getElementById('searchEmpId').value = '';
      document.getElementById('btnSubmit').innerHTML = '<i class="fa-solid fa-paper-plane"></i> ยืนยันและบันทึกข้อมูล';
      isEditingExisting = false;
      loadedBookingDate = null;
      goToStep(1, { skipValidation: true });
      updateTicketPreview();
    }

    // Initialize preview on load
    window.onload = function() {
      updateStepIndicator();
      updateNavButtons();
      updateTicketPreview();
      refreshAvailability();
    };
  </script>
</body>
</html>
