    <!-- CLIENT FRONTEND SCRIPT -->
    <script>
        // MOCK DATA FOR LOCAL TESTING PREVIEW IF GOOGLE.SCRIPT.RUN IS NOT AVAILABLE
        const mockData = [
            { empId: "560101", name: "นาย สมชาย ใจดี", dept: "ฝ่ายผลิต", section: "ส่วนผลิตขนมปัง", unit: "แผนกอบขนม", position: "พนักงานผลิตระดับ 2", hireDate: "10/03/2556", mainProgram: "โปรแกรมมาตรฐาน", riskCheck: "ความเสี่ยงจากการทำงานกับความร้อน", location: "รพ. เพชรเวช", checkDate: "15/01/2569" },
            { empId: "560102", name: "นางสาว วิภาดา สายชล", dept: "ฝ่ายผลิต", section: "ส่วนผลิตขนมปัง", unit: "แผนกอบขนม", position: "หัวหน้าทีมผลิต", hireDate: "22/07/2554", mainProgram: "โปรแกรมมาตรฐาน + ไขมันในเลือด", riskCheck: "ความเสี่ยงจากการทำงานกับความร้อน", location: "รพ. เพชรเวช", checkDate: "15/01/2569" },
            { empId: "580205", name: "นาย อภิสิทธิ์ วงศ์สว่าง", dept: "ฝ่ายการตลาด", section: "ส่วนส่งเสริมการขาย", unit: "แผนกสื่อสารแบรนด์", position: "เจ้าหน้าที่การตลาด", hireDate: "05/01/2558", mainProgram: "โปรแกรมมาตรฐาน + คลื่นไฟฟ้าหัวใจ", riskCheck: "-", location: "รพ. เพชรเวช", checkDate: "16/01/2569" },
            { empId: "600312", name: "นาย กิตติศักดิ์ พรหมมี", dept: "ฝ่ายคลังสินค้าและจัดส่ง", section: "ส่วนจัดขนส่ง", unit: "แผนกขนส่งกรุงเทพ", position: "พนักงานขับรถขนส่ง", hireDate: "18/09/2560", mainProgram: "โปรแกรมมาตรฐาน + สมรรถภาพการมองเห็น", riskCheck: "ความเสี่ยงจากการขับขี่ยานพาหนะ", location: "รพ. เพชรเวช", checkDate: "17/01/2569" }
        ];

        let rawFilters = { depts: [], sections: [], units: [], combos: [] };

        // INITIALIZATION
        document.addEventListener('DOMContentLoaded', () => {
            loadInitialFilters();
        });

        function loadInitialFilters() {
            if (typeof google !== 'undefined' && google.script && google.script.run) {
                google.script.run
                    .withSuccessHandler(populateFilters)
                    .withFailureHandler(handleError)
                    .getInitialFilters();
            } else {
                // Fallback Mock data for preview mode
                const depts = [...new Set(mockData.map(d => d.dept))].sort();
                const sections = [...new Set(mockData.map(d => d.section))].sort();
                const units = [...new Set(mockData.map(d => d.unit))].sort();
                const combos = mockData.map(d => ({ dept: d.dept, section: d.section, unit: d.unit }));
                populateFilters({ depts, sections, units, combos });
            }
        }

        function populateFilters(data) {
            rawFilters = data;
            const deptSelect = document.getElementById('select-ฝ่าย');
            deptSelect.innerHTML = '<option value="">-- ทุกฝ่าย --</option>';
            data.depts.forEach(d => {
                deptSelect.innerHTML += `<option value="${d}">${d}</option>`;
            });

            populateSectionOptions();
            populateUnitOptions();
        }

        function onฝ่ายChange() {
            populateSectionOptions();
            populateUnitOptions();
        }

        function onส่วนChange() {
            populateUnitOptions();
        }

        // FIX: ใช้ rawFilters.combos (ข้อมูลจริงรายแถวจาก Sheet) กรองแบบไล่ระดับ
        // เดิมโค้ดจะกรองเฉพาะตอนอยู่ในโหมดพรีวิว (mock) เท่านั้น ทำให้ตอนใช้งานจริงบน
        // Apps Script dropdown "ส่วน" และ "แผนก" จะโชว์รายการทั้งหมด ไม่กรองตามฝ่ายที่เลือก
        function populateSectionOptions() {
            const selectedDept = document.getElementById('select-ฝ่าย').value;
            const secSelect = document.getElementById('select-ส่วน');
            secSelect.innerHTML = '<option value="">-- ทุกส่วน --</option>';

            let filteredSections;
            if (selectedDept) {
                filteredSections = [...new Set(
                    rawFilters.combos
                        .filter(c => c.dept === selectedDept)
                        .map(c => c.section)
                        .filter(Boolean)
                )].sort();
            } else {
                filteredSections = rawFilters.sections;
            }

            filteredSections.forEach(s => {
                secSelect.innerHTML += `<option value="${s}">${s}</option>`;
            });
        }

        function populateUnitOptions() {
            const selectedDept = document.getElementById('select-ฝ่าย').value;
            const selectedSec = document.getElementById('select-ส่วน').value;
            const unitSelect = document.getElementById('select-แผนก');
            unitSelect.innerHTML = '<option value="">-- ทุกแผนก --</option>';

            let filteredUnits;
            if (selectedDept || selectedSec) {
                filteredUnits = [...new Set(
                    rawFilters.combos
                        .filter(c =>
                            (!selectedDept || c.dept === selectedDept) &&
                            (!selectedSec || c.section === selectedSec)
                        )
                        .map(c => c.unit)
                        .filter(Boolean)
                )].sort();
            } else {
                filteredUnits = rawFilters.units;
            }

            filteredUnits.forEach(u => {
                unitSelect.innerHTML += `<option value="${u}">${u}</option>`;
            });
        }

        // MODAL POPUP: เปิด/ปิดหน้าต่างค้นหาแบบกระจกใส (glassmorphism)
        function openModal(which) {
            hideAlert();
            document.getElementById('modal-id-error').classList.add('hidden');
            document.getElementById('modal-id').classList.toggle('hidden', which !== 'id');
            document.getElementById('modal-dept').classList.toggle('hidden', which !== 'dept');
            document.getElementById('modal-image').classList.toggle('hidden', which !== 'image');
            document.getElementById('modal-schedule').classList.toggle('hidden', which !== 'schedule');
            document.getElementById('modal-overlay').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            document.getElementById('modal-overlay').classList.add('hidden');
            document.body.style.overflow = '';
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
        });

        // SEARCH BY DEPT (แบบที่ 1)
        function handleSearchDept(e) {
            e.preventDefault();
            const dept = document.getElementById('select-ฝ่าย').value;
            const section = document.getElementById('select-ส่วน').value;
            const unit = document.getElementById('select-แผนก').value;

            closeModal();
            showLoading(true);
            hideAlert();
            hideResults();

            if (typeof google !== 'undefined' && google.script && google.script.run) {
                google.script.run
                    .withSuccessHandler(renderDeptResults)
                    .withFailureHandler(handleError)
                    .searchData(dept, section, unit, null);
            } else {
                // Mock search logic
                setTimeout(() => {
                    const filtered = mockData.filter(m => {
                        let match = true;
                        if (dept && m.dept !== dept) match = false;
                        if (section && m.section !== section) match = false;
                        if (unit && m.unit !== unit) match = false;
                        return match;
                    });
                    renderDeptResults(filtered);
                }, 400);
            }
        }

        // SEARCH BY ID (แบบที่ 2)
        function handleSearchId(e) {
            e.preventDefault();
            const empId = document.getElementById('input-emp-id').value.trim();
            const inlineErr = document.getElementById('modal-id-error');

            if (!empId) {
                inlineErr.classList.remove('hidden');
                return;
            }
            inlineErr.classList.add('hidden');

            closeModal();
            showLoading(true);
            hideAlert();
            hideResults();

            if (typeof google !== 'undefined' && google.script && google.script.run) {
                google.script.run
                    .withSuccessHandler(renderIndividualResults)
                    .withFailureHandler(handleError)
                    .searchData(null, null, null, empId);
            } else {
                // Mock search logic
                setTimeout(() => {
                    const filtered = mockData.filter(m => m.empId.toLowerCase().includes(empId.toLowerCase()));
                    renderIndividualResults(filtered);
                }, 400);
            }
        }

        // RENDER DEPT RESULTS (แบบที่ 1)
        function renderDeptResults(data) {
            showLoading(false);
            if (!data || data.length === 0) {
                showAlert('ไม่พบข้อมูลตามสังกัดที่เลือก', 'warning');
                return;
            }

            const deptVal = document.getElementById('select-ฝ่าย').value || 'ทุกฝ่าย';
            const secVal = document.getElementById('select-ส่วน').value || 'ทุกส่วน';
            const unitVal = document.getElementById('select-แผนก').value || 'ทุกแผนก';

            document.getElementById('res-dept-title').innerText = `ฝ่าย: ${deptVal} | ส่วน: ${secVal} | แผนก: ${unitVal}`;
            document.getElementById('res-dept-count').innerText = data.length;

            const tbody = document.getElementById('dept-table-body');
            tbody.innerHTML = '';

            data.forEach((emp, idx) => {
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50 transition-colors whitespace-nowrap">
                        <td class="p-3.5 text-center font-medium text-slate-500">${idx + 1}</td>
                        <td class="p-3.5 font-mono font-bold text-pb-red">${emp.empId}</td>
                        <td class="p-3.5 font-semibold text-slate-800">${emp.name}</td>
                        <td class="p-3.5 text-slate-600">${emp.position}</td>
                        <td class="p-3.5 text-slate-600">${emp.hireDate}</td>
                        <td class="p-3.5 text-center" title="${escapeHtml(emp.mainProgram)}">${renderRightIcon(emp)}</td>
                        <td class="p-3.5 text-slate-600">${emp.riskCheck}</td>
                    </tr>
                `;
            });

            document.getElementById('result-dept-container').classList.remove('hidden');
        }

        // DOWNLOAD PDF: สร้าง PDF ฝั่งเซิร์ฟเวอร์ด้วย Google Docs (DocumentApp) ผ่าน
        // generateDeptPdf() ใน Code.gs แทนการใช้ html2canvas (มีบั๊กเรื่องสระ/วรรณยุกต์
        // ไทย) หรือ window.print() (ต้องกด Save as PDF เอง) เพื่อให้ได้ทั้งความถูกต้อง
        // ของข้อความไทย 100% และดาวน์โหลดไฟล์อัตโนมัติแบบคลิกเดียวเหมือนเดิม โดยข้อมูล
        // สุขภาพพนักงานไม่ต้องออกไปประมวลผลนอก Google Workspace เลย
        function downloadDeptPDF() {
            const container = document.getElementById('result-dept-container');
            if (!container || container.classList.contains('hidden')) return;

            const deptVal = document.getElementById('select-ฝ่าย').value || '';
            const secVal = document.getElementById('select-ส่วน').value || '';
            const unitVal = document.getElementById('select-แผนก').value || '';

            const btn = document.getElementById('btn-download-pdf');
            const btnIcon = document.getElementById('btn-download-pdf-icon');
            const btnLabel = document.getElementById('btn-download-pdf-label');
            const originalIconClass = btnIcon.className;
            const originalLabel = btnLabel.innerText;
            btn.disabled = true;
            btnIcon.className = 'fa-solid fa-spinner fa-spin mr-1';
            btnLabel.innerText = 'กำลังสร้าง PDF...';

            function resetBtn() {
                btn.disabled = false;
                btnIcon.className = originalIconClass;
                btnLabel.innerText = originalLabel;
            }

            google.script.run
                .withSuccessHandler(function (result) {
                    resetBtn();
                    // แปลง base64 ที่ได้จากเซิร์ฟเวอร์ -> Blob แล้วสั่งดาวน์โหลดฝั่ง client
                    const byteChars = atob(result.base64);
                    const byteNumbers = new Array(byteChars.length);
                    for (let i = 0; i < byteChars.length; i++) byteNumbers[i] = byteChars.charCodeAt(i);
                    const blob = new Blob([new Uint8Array(byteNumbers)], { type: 'application/pdf' });

                    const link = document.createElement('a');
                    link.href = URL.createObjectURL(blob);
                    link.download = result.filename;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    setTimeout(function () { URL.revokeObjectURL(link.href); }, 5000);
                })
                .withFailureHandler(function (err) {
                    resetBtn();
                    handleError(err);
                })
                .generateDeptPdf(deptVal, secVal, unitVal);
        }



        // ป้องกัน HTML injection เวลาแทรกข้อความจากชีทลงใน template string
        function escapeHtml(str) {
            return String(str == null ? '' : str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        // ถ้า "ตรวจปัจจัยเสี่ยง" มีหลายรายการคั่นด้วย "," ให้ตัดขึ้นบรรทัดใหม่
        // พร้อมใส่ "-" นำหน้าแต่ละรายการ เช่น "ไวรัสตับอักเสบ เอ, Stool Culture, การได้ยิน"
        // -> "-ไวรัสตับอักเสบ เอ<br>-Stool Culture<br>-การได้ยิน"
        function formatRiskCheckHtml(value) {
            if (value == null || value === '' || value === '-') return '-';
            if (String(value).indexOf(',') === -1) return escapeHtml(value);
            const items = String(value).split(',').map(s => s.trim()).filter(Boolean);
            return items.map(item => '-' + escapeHtml(item)).join('<br>');
        }

        // โปรแกรมหลักในตารางรายแผนก: มีสิทธิ์ตรวจ = ? สีเขียว / ไม่มีสิทธิ์ตรวจ = ? สีแดง
        // (ว่าง, "-", หรือขึ้นต้นด้วย "ไม่ได้รับสิทธิ"/"ไม่มีสิทธิ" ถือว่าไม่มีสิทธิ์)
        function isCheckupRightGranted(emp) {
            const val = (emp && emp.mainProgram != null) ? String(emp.mainProgram).trim() : '';
            if (val === '' || val === '-') return false;
            return !/^ไม่(ได้รับ|มี)สิทธิ/.test(val);
        }
        function renderRightIcon(emp) {
            return isCheckupRightGranted(emp)
                ? '<span class="inline-flex items-center gap-1 font-bold text-emerald-600"><i class="fa-solid fa-check"></i></span>'
                : '<span class="inline-flex items-center gap-1 font-bold text-red-600"><i class="fa-solid fa-xmark"></i></span>';
        }

        // FIX: เช็คว่าพนักงานคนนี้ "มีสิทธิ์ตรวจ" ปีนี้หรือไม่ ดูจากคอลัมน์ H (โปรแกรมหลัก)
        // ถ้าช่องนี้ว่าง/เป็น "-" แปลว่ายังไม่ได้รับสิทธิ์ตรวจสุขภาพประจำปีนี้
        function hasCheckupEligibility(emp) {
            const val = (emp && emp.mainProgram != null) ? String(emp.mainProgram).trim() : '';
            return val !== '' && val !== '-';
        }

        // FIX: บางข้อความในคอลัมน์ "โปรแกรมหลัก" ไม่ใช่ชื่อโปรแกรมตรวจจริงๆ (เช่น
        // "ไม่ได้รับสิทธิตรวจ" หรือข้อความให้ไปตรวจที่ รพ. พระราม 9 ที่มีขั้นตอนแยกต่างหาก)
        // จึงไม่ควรมีปุ่ม "ดูรูปโปรแกรม" ให้กดเปิดรูปโปรแกรมตรวจสุขภาพทั่วไป
        function shouldShowProgramImageButton(emp) {
            const val = (emp && emp.mainProgram != null) ? String(emp.mainProgram).trim() : '';
            const excluded = ['ไม่ได้รับสิทธิตรวจ', 'เข้ารับการตรวจโรงพยาบาลพระราม 9'];
            return hasCheckupEligibility(emp) && !excluded.includes(val);
        }

        // FIX: รายชื่อ "สถานที่ตรวจ" (คอลัมน์ J) 25 สาขาที่ออกหน่วยตรวจสุขภาพตามรูป
        // ตารางวัน-เวลาที่แนบมา (Annual Health Check Up 2026) ใช้เทียบกับ emp.location
        // เพื่อตัดสินใจว่าจะโชว์ปุ่ม "ดูโปรแกรม" (ตารางวัน-เวลาออกตรวจ) ให้พนักงานคนนั้นหรือไม่
        const SCHEDULE_BRANCH_LIST = [
            'สาขาบางบัวทอง',
            'สาขาพระยาสุเรนทร์',
            'สาขารังสิต',
            'สาขาศรีนครินทร์',
            'สาขาประชาชื่น',
            'สาขาสายไหม',
            'สาขาตลิ่งชัน',
            'สาขานครปฐม',
            'สาขาพัทยา',
            'สาขาพระราม3',
            'สาขาทุ่งครุ',
            'สาขากิ่งแก้ว',
            'สาขาชลบุรี',
            'สาขาลพบุรี',
            'สาขาอยุธยา',
            'สาขานครสวรรค์',
            'สาขาจันทบุรี',
            'สาขาหัวหิน',
            'สาขากบินทร์บุรี',
            'สาขาสุพรรณบุรี',
            'สาขาบางปะกง',
            'สาขาสมุทรปราการ',
            'สาขาสมุทรสาคร',
            'สาขาสระบุรี',
            'สาขากาญจนบุรี'
        ];

        // FIX: normalize ตัดช่องว่างหัว-ท้ายและอักขระที่มองไม่เห็นก่อนเทียบ เพราะข้อมูล
        // ในชีทบางแถวอาจมีเว้นวรรคเกินมา (เช่น "สาขาสายไหม " ตามในรูปตารางต้นฉบับ)
        // ใช้ indexOf แทนการเทียบเท่ากันตรงๆ เผื่อคอลัมน์สถานที่ตรวจมีข้อความเพิ่มเติม
        // ต่อท้ายชื่อสาขา (เช่น ที่อยู่/หมายเหตุ) ไม่ให้พลาดปุ่มไปเฉยๆ
        function shouldShowScheduleImageButton(emp) {
            const loc = (emp && emp.location != null) ? String(emp.location).trim() : '';
            if (!loc || loc === '-') return false;
            return SCHEDULE_BRANCH_LIST.some(branch => loc.indexOf(branch) !== -1);
        }

        // RENDER INDIVIDUAL RESULTS (แบบที่ 2)
        // FIX: ค้นหารายบุคคลตอนนี้กรองให้เหลือเฉพาะพนักงานที่ "มีสิทธิ์ตรวจ" เท่านั้น
        // (มีโปรแกรมหลักระบุไว้ในคอลัมน์ H) เดิมถ้าเจอรหัสพนักงานก็โชว์การ์ดผลลัพธ์ทันที
        // ไม่ว่าจะมีสิทธิ์ปีนี้หรือไม่ ทำให้พนักงานที่ยังไม่ได้รับสิทธิ์เห็นการ์ดเปล่าๆ/
        // ข้อมูลเก่าที่ทำให้เข้าใจผิดว่ามีสิทธิ์ จึงแยกเป็น 2 กรณี: ไม่พบรหัสเลย vs
        // พบรหัสแต่ไม่มีสิทธิ์ปีนี้ (แจ้งข้อความต่างกันให้ชัดเจน)
        function renderIndividualResults(data) {
            showLoading(false);
            if (!data || data.length === 0) {
                showAlert('ไม่พบข้อมูลรหัสพนักงานที่ระบุ กรุณาตรวจสอบอีกครั้ง', 'warning');
                return;
            }

            const eligible = data.filter(hasCheckupEligibility);
            if (eligible.length === 0) {
                showAlert('พบรหัสพนักงานที่ระบุ แต่ไม่มีสิทธิ์ตรวจสุขภาพประจำปี 2569 กรุณาติดต่อฝ่ายบุคคล', 'warning');
                return;
            }

            const wrapper = document.getElementById('individual-cards-wrapper');
            wrapper.innerHTML = '';

            eligible.forEach(emp => {
                wrapper.innerHTML += `
                    <div class="bg-white rounded-xl border border-slate-200 shadow-md overflow-hidden">
                        <!-- Employee Profile Header -->
                        <div class="bg-gradient-to-r from-pb-red to-teal-800 text-white p-6">
                            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                                <div class="flex items-center space-x-4">
                                    <div class="w-16 h-16 bg-white text-pb-red rounded-full flex items-center justify-center font-bold text-2xl shadow-inner">
                                        <i class="fa-solid fa-user"></i>
                                    </div>
                                    <div>
                                        <span class="bg-white/20 text-white text-xs px-2 py-0.5 rounded font-mono mb-1 inline-block">รหัสพนักงาน: ${emp.empId}</span>
                                        <h2 class="text-2xl font-semibold">${emp.name}</h2>
                                        <p class="text-teal-100 text-sm">${emp.position}</p>
                                    </div>
                                </div>
                                <div class="bg-white/10 backdrop-blur-sm p-3 rounded-lg border border-white/20 text-xs space-y-1">
                                    <p><strong class="text-amber-300">ฝ่าย:</strong> ${emp.dept}</p>
                                    <p><strong class="text-amber-300">ส่วน:</strong> ${emp.section}</p>
                                    <p><strong class="text-amber-300">แผนก:</strong> ${emp.unit}</p>
                                </div>
                            </div>
                        </div>

                        <!-- Employee Checkup Details -->
                        <div class="p-6">
                            <div class="flex items-center mb-4 border-b border-slate-100 pb-3">
                                <h3 class="font-bold text-slate-800 flex items-center text-base">
                                    <i class="fa-solid fa-notes-medical text-pb-red mr-2"></i>
                                    รายละเอียดสิทธิการตรวจสุขภาพประจำปี 2569
                                </h3>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                <div class="flex items-start space-x-3 p-3 bg-emerald-50/60 rounded-lg border border-emerald-100">
                                    <div class="mt-0.5 w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center flex-shrink-0 text-xs font-bold">
                                        <i class="fa-solid fa-clipboard-list"></i>
                                    </div>
                                    <div class="flex-1 flex items-center justify-between gap-2 flex-wrap">
                                        <div>
                                            <p class="text-xs font-semibold text-slate-500">โปรแกรมหลัก</p>
                                            <p class="text-sm font-medium text-slate-800">${emp.mainProgram}</p>
                                        </div>
                                        <button type="button" onclick="openModal('image')" class="no-print flex-shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1.5 bg-pb-red hover:bg-pb-darkred text-white rounded-lg text-xs font-medium transition-colors ${shouldShowProgramImageButton(emp) ? '' : 'hidden'}">
                                            <i class="fa-solid fa-image"></i> ดูรูปโปรแกรม
                                        </button>
                                    </div>
                                </div>
                                <div class="flex items-start space-x-3 p-3 bg-emerald-50/60 rounded-lg border border-emerald-100">
                                    <div class="mt-0.5 w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center flex-shrink-0 text-xs font-bold">
                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                    </div>
                                    <div>
                                        <p class="text-xs font-semibold text-slate-500">ตรวจปัจจัยเสี่ยง</p>
                                        <p class="text-sm font-medium text-slate-800 leading-relaxed">${formatRiskCheckHtml(emp.riskCheck)}</p>
                                    </div>
                                </div>
                                <div class="flex items-start space-x-3 p-3 bg-emerald-50/60 rounded-lg border border-emerald-100">
                                    <div class="mt-0.5 w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center flex-shrink-0 text-xs font-bold">
                                        <i class="fa-solid fa-hospital"></i>
                                    </div>
                                    <div>
                                        <p class="text-xs font-semibold text-slate-500">สถานที่ตรวจ</p>
                                        <p class="text-sm font-medium text-slate-800">${emp.location}</p>
                                    </div>
                                </div>
                                <div class="flex items-start space-x-3 p-3 bg-emerald-50/60 rounded-lg border border-emerald-100">
                                    <div class="mt-0.5 w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center flex-shrink-0 text-xs font-bold">
                                        <i class="fa-solid fa-calendar-days"></i>
                                    </div>
                                    <div class="flex-1 flex items-center justify-between gap-2 flex-wrap">
                                        <div>
                                            <p class="text-xs font-semibold text-slate-500">วันที่ตรวจ</p>
                                            <p class="text-sm font-medium text-slate-800">${emp.checkDate}</p>
                                        </div>
                                        <button type="button" onclick="openModal('schedule')" class="no-print flex-shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1.5 bg-pb-red hover:bg-pb-darkred text-white rounded-lg text-xs font-medium transition-colors ${shouldShowScheduleImageButton(emp) ? '' : 'hidden'}">
                                            <i class="fa-solid fa-calendar-check"></i> ดูตารางวัน-เวลาตรวจ
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });

            document.getElementById('result-id-container').classList.remove('hidden');
        }

        // HELPER FUNCTIONS
        function resetFormDept() {
            document.getElementById('select-ฝ่าย').value = '';
            document.getElementById('select-ส่วน').value = '';
            document.getElementById('select-แผนก').value = '';
            populateSectionOptions();
            populateUnitOptions();
            hideResults();
            hideAlert();
        }

        function showLoading(show) {
            const spinner = document.getElementById('loading-spinner');
            if (show) spinner.classList.remove('hidden');
            else spinner.classList.add('hidden');
        }

        function hideResults() {
            document.getElementById('result-dept-container').classList.add('hidden');
            document.getElementById('result-id-container').classList.add('hidden');
        }

        function showAlert(msg, type) {
            const alertBox = document.getElementById('alert-box');
            const alertMsg = document.getElementById('alert-msg');
            const alertIcon = document.getElementById('alert-icon');

            alertMsg.innerText = msg;
            alertBox.classList.remove('hidden', 'bg-red-50', 'border-red-200', 'text-red-700', 'bg-yellow-50', 'border-yellow-200', 'text-yellow-700');

            if (type === 'error') {
                alertBox.classList.add('bg-red-50', 'border-red-200', 'text-red-700');
                alertIcon.className = 'fa-solid fa-circle-exclamation text-red-500';
            } else {
                alertBox.classList.add('bg-yellow-50', 'border-yellow-200', 'text-yellow-700');
                alertIcon.className = 'fa-solid fa-triangle-exclamation text-yellow-500';
            }
        }

        function hideAlert() {
            document.getElementById('alert-box').classList.add('hidden');
        }

        function handleError(err) {
            showLoading(false);
            showAlert('เกิดข้อผิดพลาดในการดึงข้อมูล: ' + (err.message || err), 'error');
        }

        function toggleGasGuide() {
            const content = document.getElementById('gas-guide-content');
            const text = document.getElementById('guide-toggle-text');
            const icon = document.getElementById('guide-toggle-icon');

            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                text.innerText = 'ซ่อนวิธีติดตั้ง';
                icon.className = 'fa-solid fa-chevron-up ml-1';
            } else {
                content.classList.add('hidden');
                text.innerText = 'แสดงวิธีติดตั้ง';
                icon.className = 'fa-solid fa-chevron-down ml-1';
            }
        }
    </script>
</body>
</html>
