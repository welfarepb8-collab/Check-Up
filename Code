// จำนวนที่นั่งสูงสุดต่อรอบ (นับตามวันที่เดินทาง 1 รอบ = รถ 1 คัน/1 วัน)
const MAX_SEATS_PER_ROUND = 10;

// รายการวันที่เดินทางทั้งหมดที่เปิดให้จอง (ใช้สำหรับสร้างตารางที่นั่งคงเหลือ)
const AVAILABLE_DATES = [
  '24 กันยายน 2569',
  '1 ตุลาคม 2569',
  '8 ตุลาคม 2569',
  '15 ตุลาคม 2569'
];

// จำนวนวันล่วงหน้าที่อนุญาตให้แก้ไข/ยกเลิกได้ก่อนถึงวันตรวจ
const LOCK_DAYS_BEFORE = 2;

// รหัสผ่านสำหรับผู้ดูแลระบบ (Admin) ใช้สำหรับแก้ไข/ยกเลิกข้อมูลแทนพนักงาน
// แม้จะเกินกำหนดเวลาที่อนุญาตให้แก้ไขได้ล่วงหน้า (LOCK_DAYS_BEFORE) แล้วก็ตาม
const ADMIN_PASSWORD = 'wf1982';

